{
  // Typecheck program for the governance scripts, mirroring the strictness of
  // the original repository base config (`noUncheckedIndexedAccess` and
  // `exactOptionalPropertyTypes` make the defensive checks in these files
  // necessary). `allowImportingTsExtensions` matches the repository's ESM
  // style of importing local `.ts` paths; scripts run through tsx, so the
  // program never emits.
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2024",
    "types": [
      "node"
    ]
  },
  "include": [
    "scripts/**/*.ts"
  ]
}
